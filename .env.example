# .env.example
# Copy this file to ~/.wmata_secrets.env on the Raspberry Pi
# DO NOT COMMIT YOUR REAL API KEY TO GITHUB!

# Your WMATA Developer API Key (from developer.wmata.com)
WMATA_API_KEY=your_api_key_here

# Comma-separated list of station codes (e.g., A01,C01 for Metro Center)
STATION_CODES=A01,C01

# Filter by platform direction (1, 2, or all)
DIRECTION_GROUP=all

# Startup display mode (transit, clock)
DISPLAY_MODE=transit

# Maximum safe brightness (1-100). Do not exceed 50 on a 4A power supply!
BRIGHTNESS=40

# Hardware mapping (regular or adafruit-hat). Test this with setup/test_matrix.py
GPIO_MAPPING=regular

# GPIO slowdown (1 or 2 is typical for Pi 3B+)
GPIO_SLOWDOWN=1

# Scroll speed (ms per pixel step)
SCROLL_SPEED_MS=30
